# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# For Docker Compose: uses service name "postgres"
DATABASE_URL=postgresql://ox:ox@postgres:5432/ox
# For local dev (no Docker): use localhost
# DATABASE_URL=postgresql://ox:ox@localhost:5432/ox

# ── Redis ─────────────────────────────────────────────────────────────────────
# For Docker Compose: uses service name "redis"
REDIS_URL=redis://redis:6379
# For local dev (no Docker): use localhost
# REDIS_URL=redis://localhost:6379

# ── OAuth (Auth0 example) ────────────────────────────────────────────────────
# Create a Regular Web Application in Auth0 and fill in these values.
OAUTH_PROVIDER=auth0
OAUTH_ISSUER_URL=https://YOUR_TENANT.auth0.com
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Must match the callback URL configured in your Auth0 application
OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/callback

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=3600

# ── Authorization ─────────────────────────────────────────────────────────────
# Comma-separated list; users with these emails get ADMIN role at login
ADMIN_EMAILS=admin@example.com

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# WebSocket URL as seen by the browser (not internal Docker network)
NEXT_PUBLIC_WS_URL=http://localhost:4000
# API proxy target (used by Next.js rewrites, not exposed to browser)
API_ORIGIN=http://localhost:4000
